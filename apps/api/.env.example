NODE_ENV=development
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/ecommerce_backend_sdd
# Remote PostgreSQL always uses TLS. Course opt-in false omits server verification
# (also allowed for the course demo NODE_ENV=production); never affects other TLS.
DATABASE_TLS_VERIFY_SERVER=true
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
CART_ANONYMOUS_TTL_SECONDS=2592000
IMAGE_STORAGE_LOCAL_ROOT=.local-storage/images
IMAGE_STORAGE_MAX_BYTES=5242880
IMAGE_STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media/images
# Catalog only; enterprise logos/PDFs keep their local storage.
# Adapter/recovery implemented; keep local until activation is explicitly authorized.
IMAGE_STORAGE_CATALOG_PROVIDER=local
# Fixed catalog destination: codex-storefront (not controlled by the browser).
# Set privately in apps/api/.env; never use NEXT_PUBLIC_* or commit secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Confirm the account folder mode before selecting Cloudinary: dynamic or fixed.
CLOUDINARY_FOLDER_MODE=
SIMULATED_SHIPPING_PICKUP_COST=0.00
SIMULATED_SHIPPING_STANDARD_COST=5.00
SIMULATED_SHIPPING_EXPRESS_COST=15.00
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-local-password
SEED_BILLING_EMAIL=billing@example.com
SEED_BILLING_PASSWORD=replace-with-a-local-password
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=replace-with-a-local-password
