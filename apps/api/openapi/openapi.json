        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Short-lived access token returned by the login endpoint"
      },
      "technology_ecommerce_refresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "technology_ecommerce_refresh",
        "description": "HttpOnly rotating refresh credential"
      }
    },
    "schemas": {
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@example.com",
            "format": "email"
          },
          "displayName": {
            "type": "string",
            "example": "Example customer",
            "maxLength": 120,
            "minLength": 2
          },
          "password": {
            "type": "string",
            "example": "a-strong-local-password",
            "format": "password",
            "maxLength": 128,
            "minLength": 12
          }
        },
        "required": [
          "email",
          "displayName",
          "password"
        ]
      },
      "AuthenticatedUserResponseDto": {
        "type": "object",
