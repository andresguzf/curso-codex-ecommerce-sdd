{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerCustomer",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed input or an attempted role assignment"
          },
          "409": {
            "description": "Email already registered"
          }
        },
        "summary": "Register a public customer account",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed credentials"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Authentication rate limit"
          }
        },
        "summary": "Authenticate a user",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponseDto"
                }
              }
            }
          }
        },
        "summary": "Issue a CSRF token for cookie-authenticated requests",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "Invalid CSRF token"
          }
        },
        "security": [
          {
            "technology_ecommerce_refresh": []
          }
        ],
        "summary": "Rotate a session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "403": {
            "description": "Invalid CSRF token"
          }
        },
        "security": [
          {
            "technology_ecommerce_refresh": []
          }
        ],
        "summary": "Revoke a session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired session"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Read current user",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/users": {
      "get": {
        "operationId": "listUsers",
        "parameters": [
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "createdAt",
                "displayName",
                "email",
                "role",
                "status"
              ],
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "ACTIVE",
                "INACTIVE",
                "BLOCKED"
              ],
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "CUSTOMER",
                "ADMIN",
                "BILLING"
              ],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters"
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "ADMIN role required"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List users",
        "tags": [
          "users"
        ]
      },
      "post": {
        "operationId": "createUser",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user data"
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "ADMIN role required"
          },
          "409": {
            "description": "Email already registered"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a user",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeUserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "ADMIN role required"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Read a user",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid user data"
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "ADMIN role required"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "Duplicate email or last active administrator"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Update a user",
        "tags": [
          "users"
        ]
      },
      "delete": {
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted logically"
          },
          "401": {
            "description": "Invalid or expired session"
          },
          "403": {
            "description": "ADMIN role required"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "Last active administrator"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Soft-delete a user",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check API and PostgreSQL readiness",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Technology Ecommerce API",
    "description": "Versioned REST contract for the technology ecommerce platform.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "authentication",
      "description": "Login, session renewal and logout"
    },
    {
      "name": "health",
      "description": "API and PostgreSQL readiness"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Short-lived access token returned by the login endpoint"
      },
      "technology_ecommerce_refresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "technology_ecommerce_refresh",
        "description": "HttpOnly rotating refresh credential"
      }
    },
    "schemas": {
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@example.com",
            "format": "email"
          },
          "displayName": {
            "type": "string",
            "example": "Example customer",
            "maxLength": 120,
            "minLength": 2
          },
          "password": {
            "type": "string",
            "example": "a-strong-local-password",
            "format": "password",
            "maxLength": 128,
            "minLength": 12
          }
        },
        "required": [
          "email",
          "displayName",
          "password"
        ]
      },
      "AuthenticatedUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "BILLING"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "a-strong-local-password",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthSessionResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived signed JWT access token"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "accessTokenExpiresAt",
          "sessionExpiresAt",
          "user"
        ]
      },
      "CsrfTokenResponseDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "Token required in the X-CSRF-Token header"
          }
        },
        "required": [
          "csrfToken"
        ]
      },
      "AdministrativeUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "BILLING"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "BLOCKED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "status",
          "createdAt",
          "updatedAt",
          "deletedAt"
        ]
      },
      "UserPageResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdministrativeUserResponseDto"
            }
          },
          "page": {
            "type": "number",
            "minimum": 1
          },
          "pageSize": {
            "type": "number",
            "maximum": 100,
            "minimum": 1
          },
          "totalItems": {
            "type": "number",
            "minimum": 0
          },
          "totalPages": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ]
      },
      "CreateUserRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Billing operator",
            "maxLength": 120,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "example": "billing@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128,
            "minLength": 12
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "BILLING"
            ]
          },
          "status": {
            "type": "string",
            "default": "ACTIVE",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "displayName",
          "email",
          "password",
          "role"
        ]
      },
      "UpdateUserRequestDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128,
            "minLength": 12
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "ADMIN",
              "BILLING"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "BLOCKED"
            ]
          }
        }
      },
      "HealthDatabaseResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up"
            ],
            "example": "up"
          },
          "name": {
            "type": "string",
            "example": "ecommerce_backend_sdd"
          }
        },
        "required": [
          "status",
          "name"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "enum": [
              "api"
            ],
            "example": "api"
          },
          "database": {
            "$ref": "#/components/schemas/HealthDatabaseResponseDto"
          }
        },
        "required": [
          "status",
          "service",
          "database"
        ]
      }
    }
  }
}
