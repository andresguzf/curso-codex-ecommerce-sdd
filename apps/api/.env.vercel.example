# Configure only in the API project's Production environment. Never commit .env.
NODE_ENV=production
# Copy the exact Session pooler URI from Supabase Connect, port 5432 (NOT 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@REPLACE_HOST.pooler.supabase.com:5432/postgres
# Explicit course exception: encrypted transport, no server certificate verification.
DATABASE_TLS_VERIFY_SERVER=false
AUTH_ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://replace-storefront.vercel.app,https://replace-backoffice.vercel.app
IMAGE_STORAGE_CATALOG_PROVIDER=cloudinary
IMAGE_STORAGE_MAX_BYTES=4194304
IMAGE_STORAGE_PUBLIC_BASE_URL=https://replace-api.vercel.app/api/v1/media/images
CLOUDINARY_CLOUD_NAME=REPLACE_PRIVATELY
CLOUDINARY_API_KEY=REPLACE_PRIVATELY
CLOUDINARY_API_SECRET=REPLACE_PRIVATELY
CLOUDINARY_FOLDER_MODE=dynamic
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# VERCEL / VERCEL_ENV are set by Vercel, not copied from this example.
# No SEED_* variables; no build/boot migrations or seed.
