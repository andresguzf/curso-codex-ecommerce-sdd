IMAGE_TAG=local

STOREFRONT_BIND_ADDRESS=127.0.0.1
STOREFRONT_PORT=3000
BACKOFFICE_BIND_ADDRESS=127.0.0.1
BACKOFFICE_PORT=3002
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001

PUBLIC_API_BASE_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001/api/v1
PUBLIC_STOREFRONT_URL=http://localhost:3000
PUBLIC_BACKOFFICE_URL=http://localhost:3002

DATABASE_URL=postgresql://postgres:replace-me@host.docker.internal:5432/ecommerce_backend_sdd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ecommerce_backend_sdd
POSTGRES_DATA_VOLUME=technology_ecommerce_postgres_data
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
IMAGE_STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media/images
API_IMAGES_VOLUME=technology_ecommerce_api_images
